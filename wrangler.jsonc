{
  // Cloudflare deploy configuration.
  //
  // This site is deployed as a Worker with static assets, not as a Pages
  // project — the Cloudflare dashboard connected the repository to a Worker and
  // deploys it with `npx wrangler deploy`. A Worker has no "build output
  // directory" field, which is why looking for one in the dashboard never
  // worked. The equivalent setting is `assets.directory` below, and keeping it
  // in the repository means it is version-controlled and reviewable rather than
  // buried in a settings page.
  //
  // WHAT THIS FIXES
  // Without it, Cloudflare inferred the whole repository as the site, so
  // eqlsource.com served CLAUDE.md, build.sh, docs/BACKLOG.md,
  // scripts/check.py and state/watchlist.json, all returning 200. Pointing
  // `assets.directory` at ./public means only the built site is uploaded.
  // Nothing internal is blocked by a rule; it is simply never deployed.
  //
  // There is no `main` script. A Worker with assets and no script serves those
  // assets directly, which is all a static site needs.

  "name": "eql-source",
  "compatibility_date": "2026-08-08",

  "assets": {
    "directory": "./public",

    // 404.html is generated by _build/build404.py and carries the site chrome,
    // so a wrong URL lands on our page rather than Cloudflare's default.
    "not_found_handling": "404-page"
  }
}
