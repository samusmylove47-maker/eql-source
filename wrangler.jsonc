{
  // Cloudflare deploy configuration.
  //
  // The host is a Worker with static assets, not a Pages project — the
  // dashboard connected the repository to a Worker and deploys it with
  // `npx wrangler deploy`. A Worker has no "build output directory" field,
  // which is why looking for one in the dashboard never worked. The
  // equivalent setting is `assets.directory` below, and keeping it in the
  // repository means it is version-controlled and reviewable rather than
  // buried in a settings page.
  //
  // WHAT THIS FIXES: the blank 404
  // Measured on eqlsource.com, 9 Aug 2026. A wrong URL returns status 404 with
  // a zero-length body — a blank white page. /404.html is deployed and correct
  // (5,745 bytes, full site chrome), but a Worker does not serve it for a miss
  // unless `not_found_handling` says to. Every real link on the site resolves,
  // so this is only reachable by mistyping a URL or following a stale one, but
  // a blank page reads as a broken site rather than a wrong address.
  //
  // WHY public/_redirects DOES NOT FIX IT
  // That file exists, is honoured, and is what makes /sky, /races and
  // /calculator work — which also proves the assets root already resolves to
  // public/, so `directory` below matches what the deploy does today rather
  // than changing it. But the `404` status code in a _redirects rule is a
  // Pages feature. On Workers, `not_found_handling` is the mechanism.
  //
  // There is no `main` script. A Worker with assets and no script serves those
  // assets directly, which is all a static site needs.
  //
  // IF THIS GOES WRONG: the failure mode is loud and total — every URL 404s,
  // visible within a minute of the deploy. Revert the merge and the site
  // returns to exactly its current behaviour.

  "name": "eql-source",
  "compatibility_date": "2026-08-08",

  "assets": {
    "directory": "./public",

    // 404.html is generated by _build/build404.py and carries the site chrome,
    // so a wrong URL lands on our page rather than a blank one.
    "not_found_handling": "404-page"

    // DO NOT ADD "html_handling": "none" HERE. IT WOULD 404 THE ENTIRE SITE.
    //
    // The site answers 307, not 301, when a reader asks for /x.html: measured
    // live, /tools/lockouts.html -> 307 -> /tools/lockouts -> 200. No redirect in
    // this repo emits a 307 - all 29 rules in public/_redirects say 301 - so the
    // 307 is Cloudflare's default html_handling, and this block not setting the
    // key is what leaves it at the default.
    //
    // The obvious way to stop a 307 is to turn html_handling off. That is the one
    // change on this site that most directly breaks the owner's standing rule
    // that an existing public URL must not 404, and it breaks it completely:
    // EVERY FILE IN public/ IS NAMED WITH .html AND NOTHING IS NAMED WITHOUT IT.
    // Turning the mapping off would 404 all 716 sitemap URLs, every canonical tag
    // on the site, and all 42 extensionless inbound links from the planner - at
    // once, on deploy.
    //
    // The 307 was addressed the other way on 1 Sep 2026: internal links went
    // extensionless, so no internal click hits the redirect at all. It still
    // fires for old bookmarks and external links, which is what it is for, and
    // every page carries a canonical naming the extensionless address so a
    // crawler is not relying on the status code to learn which URL is real.
    //
    // Cloudflare exposes no setting that makes this particular redirect a 301.
    // If one appears, it is still a serving-layer change and it is still capable
    // of 404ing the site, so measure it against a preview deploy first.
  }
}
