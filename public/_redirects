# chat, so it goes to the tool that replaced it rather than to a dead end. There
# is no tombstone page: the withdrawal is recorded in the change log, which is
# where removals belong.
/tools/plane-of-sky.html  /tools/sky-ledger.html  301
/tools/plane-of-sky       /tools/sky-ledger.html  301

